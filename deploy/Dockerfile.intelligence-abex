ARG ABEX_BASE_IMAGE=orqevia:official-logo-891e3adf
FROM ${ABEX_BASE_IMAGE}
WORKDIR /service
COPY app /service/app
ARG ORQEVIA_SOURCE_REVISION=UNKNOWN
ENV ORQEVIA_SOURCE_REVISION=${ORQEVIA_SOURCE_REVISION} PYTHONDONTWRITEBYTECODE=1
LABEL org.opencontainers.image.revision=${ORQEVIA_SOURCE_REVISION}
CMD ["python","-B","-m","uvicorn","app.orqevia.deployment:app","--host","0.0.0.0","--port","8100","--no-proxy-headers","--workers","1"]
