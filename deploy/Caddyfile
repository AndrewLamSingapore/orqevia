{
	admin off
}

:8080 {
	@health path /health
	handle @health {
		# Gateway liveness only. Backend health remains protected by its
		# loopback/trusted-peer boundary and is checked inside the backend.
		header X-ORQEVIA-Health-Scope "GATEWAY_ONLY"
		respond "ok" 200
	}

	@authenticated_integrations {
		path /api/integrations/*
		header Authorization "Bearer {$PRIME_INTEGRATION_TOKEN}"
	}
	handle @authenticated_integrations {
		reverse_proxy backend:8000
	}

	handle /api/integrations/* {
		respond "Unauthorized" 401
	}

	handle {
		respond "Not Found" 404
	}
}
