# Apply a reviewed request-transport change over the retained production image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY requirements.pip-security.txt /tmp/orqevia-pip-security.txt
RUN python -m pip install --no-cache-dir --no-deps --require-hashes --index-url https://pypi.org/simple -r /tmp/orqevia-pip-security.txt
COPY app /app/app/
COPY clients/pwa/index.html clients/pwa/recovery.js clients/pwa/release.mjs clients/pwa/app.mjs clients/pwa/core.mjs clients/pwa/storage.mjs clients/pwa/style.css clients/pwa/sw.js clients/pwa/voice.mjs clients/pwa/manifest.webmanifest /app/app/pwa_static/
COPY clients/pwa/reset.html clients/pwa/reset.mjs clients/pwa/projects.html clients/pwa/projects.css clients/pwa/projects.mjs /app/app/pwa_static/
COPY clients/pwa/dashboard.mjs clients/pwa/dashboard.css clients/pwa/intelligence.mjs clients/pwa/integration-panels.mjs clients/pwa/intelligence.css clients/pwa/command-center.css /app/app/pwa_static/
COPY clients/pwa/knowledge.mjs clients/pwa/knowledge.css clients/pwa/workspace-tools.mjs clients/pwa/command-map.mjs clients/pwa/command-map.css clients/pwa/agent-readiness.json clients/pwa/registry.json /app/app/pwa_static/
COPY clients/pwa/sovereign.css clients/pwa/sovereign.mjs clients/pwa/operations.mjs clients/pwa/intelligence-capabilities.mjs /app/app/pwa_static/
COPY clients/pwa/vendor /app/app/pwa_static/vendor
COPY clients/pwa/icons /app/app/pwa_static/icons
COPY clients/shared /app/app/shared_static
ARG ORQEVIA_RUNTIME_REVISION
ENV ORQEVIA_RUNTIME_REVISION=${ORQEVIA_RUNTIME_REVISION}
LABEL org.opencontainers.image.revision=${ORQEVIA_RUNTIME_REVISION}
