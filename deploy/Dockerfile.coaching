# Reuse an independently retained, locally pinned runtime dependency layer.
# No packages, models or credentials are downloaded during this build.
ARG ORQEVIA_COACHING_BASE_IMAGE
FROM ${ORQEVIA_COACHING_BASE_IMAGE}
COPY app /app/app
COPY config /app/config
ARG ORQEVIA_COACHING_SOURCE_REVISION
ENV ORQEVIA_COACHING_SOURCE_REVISION=$ORQEVIA_COACHING_SOURCE_REVISION
LABEL org.opencontainers.image.revision=$ORQEVIA_COACHING_SOURCE_REVISION
CMD ["python", "-B", "-m", "app.agent_coaching"]
