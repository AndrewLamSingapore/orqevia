# Local Ollama models
PRIME_FAST_MODEL=gemma3:1b
PRIME_DEEP_MODEL=gemma3:1b
PRIME_EMBED_MODEL=embeddinggemma:300m-qat-q4_0

# Keep PRIME private by default. Use an authenticated TLS/private-overlay layer
# for remote access instead of exposing port 8000 directly to the Internet.
PRIME_BIND_ADDRESS=127.0.0.1
PRIME_PORT=8000

# For a production host, pin PRIME_IMAGE to the verified commit-addressable
# GitHub Container Registry image instead of a floating tag.
# PRIME_IMAGE=ghcr.io/andrewlamsingapore/prime:sha-<verified-40-character-commit>

# Cross-project service authentication. Generate long random values locally;
# never commit populated secrets. PRIME_INTEGRATION_TOKEN must match VELYQUA.
PRIME_INTEGRATION_TOKEN=

# PRIME sends bounded experiment results to this authenticated Portal endpoint.
PORTAL_RESULT_URL=https://the-portal-ten.vercel.app/api/experiment-result

# PORTAL_RESULT_TOKEN must match the encrypted Portal production variable.
PORTAL_RESULT_TOKEN=
