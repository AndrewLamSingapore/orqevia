# One canonical Compose project prevents duplicate PRIME/Ollama stacks.
COMPOSE_PROJECT_NAME=prime

# Local Ollama models
PRIME_FAST_MODEL=gemma3:1b
PRIME_DEEP_MODEL=gemma3:1b
PRIME_EMBED_MODEL=embeddinggemma:300m-qat-q4_0
# Two concurrent generations avoid saturating the Dell host. Benchmark before increasing.
PRIME_MULTI_SPECIALIST_WORKERS=2

# Keep PRIME private by default.
PRIME_BIND_ADDRESS=127.0.0.1
PRIME_PORT=8000

# Pin production to the exact verified commit-addressable image.
# PRIME_IMAGE=ghcr.io/andrewlamsingapore/prime:sha-<verified-commit>

# The operations script adopts existing named volumes automatically.
# Set these explicitly only when restoring a known checkpoint.
# PRIME_DATA_VOLUME=prime-data
# OLLAMA_DATA_VOLUME=prime-ollama-data

# Optional third-party image pins. Prefer tested immutable tags or digests.
# OLLAMA_IMAGE=ollama/ollama:<tested-tag-or-digest>
# CADDY_IMAGE=caddy:<tested-tag-or-digest>
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:<tested-tag-or-digest>

# Stable Spine + protected read access. Use an independent long random value.
PRIME_SPINE_TOKEN=

# The Portal is PRIME's external knowledge grounding source. Read-only from PRIME.
PORTAL_BASE_URL=https://the-portal-ten.vercel.app

# Closed evidence loop. Generate independent long random values locally.
PRIME_INTEGRATION_TOKEN=
PORTAL_RESULT_URL=https://the-portal-ten.vercel.app/api/experiment-result
PORTAL_RESULT_TOKEN=
PORTAL_PRIME_TOKEN=

# Persistent remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
PRIME_PUBLIC_URL=
