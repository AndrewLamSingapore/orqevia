# One canonical Compose project prevents duplicate ORQEVIA/Ollama stacks.
COMPOSE_PROJECT_NAME=orqevia

# Runtime independence: host identity is separate from ORQEVIA logical identity.
PRIME_NODE_ID=orqevia-node-01
PRIME_NODE_ROLE=control-compute
# Required before exposing the authenticated interface identity endpoint.
PRIME_INTERFACE_HOST_ID=
# Private physical-client HTTPS surface. These are deployment inputs and must
# not point at a public interface unless a separate exposure decision is made.
PRIME_INTERFACE_BIND_ADDRESS=
PRIME_INTERFACE_PORT=8443
PRIME_INTERFACE_TLS_DIR=
PRIME_INTERFACE_SPKI_SHA256=
PRIME_INTERFACE_PUBLIC_KEY=
PRIME_INTERFACE_RUNTIME_VERSION=UNKNOWN
PRIME_RUNTIME_REVISION=UNKNOWN
PRIME_INTERFACE_CANDIDATE_STATUS=UNKNOWN
PRIME_PWA_ORIGIN=
# Optional exact additional browser origin for the interface.
PRIME_PWA_ADDITIONAL_ORIGINS=
PRIME_PWA_OWNER_ACCOUNT_ID=
PRIME_PWA_PROFILE_PATH=
PRIME_PWA_DATA_CLASSIFICATION=LOCAL_ONLY
PRIME_PWA_MAX_COST_USD=0

# Compute tiers: compat (smallest), balanced (recommended), max (benchmark first).
PRIME_COMPUTE_PROFILE=balanced
PRIME_FAST_MODEL=gemma3:1b
PRIME_DEEP_MODEL=gemma3:4b
PRIME_EVALUATOR_MODEL=gemma3:4b
PRIME_EMBED_MODEL=embeddinggemma:300m-qat-q4_0
PRIME_MULTI_SPECIALIST_WORKERS=3
PRIME_CONTEXT_TOKENS=16384
PRIME_MAX_OUTPUT_TOKENS=4096
PRIME_MODEL_KEEP_ALIVE=-1

# Ollama capacity controls. Use docker-compose.gpu.yml only after GPU preflight passes.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_MAX_QUEUE=256
OLLAMA_KEEP_ALIVE=-1
OLLAMA_FLASH_ATTENTION=true
OLLAMA_KV_CACHE_TYPE=q8_0

# Shared governed queue for the canonical 21-agent registry. Keep one local
# inference slot until measured hardware admission is configured and qualified.
PRIME_QUEUE_CONCURRENCY=1
# Golden N=1 is the default for the listed observed model names. Its 1024 MiB
# ceiling is on declared demand, not measured model memory. Measured mode
# requires a pinned Compute Profile, protected receipt, and fresh telemetry.
PRIME_LOCAL_ADMISSION_MODE=golden_n1
PRIME_AGENT_CONCURRENCY=1
PRIME_READY_ACTIVITY_MAX_AGE_SECONDS=3600
PRIME_LOCAL_RAM_MB=32768
PRIME_LOCAL_VRAM_MB=0
PRIME_CLOUD_WAIT_SECONDS=300
PRIME_MAX_JOB_COST_USD=2
PRIME_DAILY_COST_USD=10

# Optional OpenAI-compatible cloud GPU. Blank means cloud execution is impossible.
# Even when configured, each cloud-capable job requires explicit approval and local-first routing.
PRIME_CLOUD_GPU_URL=
PRIME_CLOUD_GPU_API_KEY=
PRIME_CLOUD_GPU_MODEL=
PRIME_CLOUD_GPU_RAM_MB=131072
PRIME_CLOUD_GPU_VRAM_MB=81920
PRIME_CLOUD_GPU_CONCURRENCY=2
PRIME_CLOUD_INPUT_USD_MTOK=0
PRIME_CLOUD_OUTPUT_USD_MTOK=0

# Keep ORQEVIA private by default.
PRIME_BIND_ADDRESS=127.0.0.1
PRIME_PORT=8000
# Exact Docker bridge gateway observed by the container. Leave empty outside
# containerized loopback-owner deployments; never use a subnet or wildcard.
PRIME_OWNER_TRUSTED_PEERS=
# PRIME_IMAGE=ghcr.io/andrewlamsingapore/orqevia:sha-<verified-commit>
# PRIME_DATA_VOLUME=orqevia-data
# OLLAMA_DATA_VOLUME=orqevia-ollama-data
# Recovery-qualified immutable image selections (2026-09-19).
# OLLAMA_IMAGE=ollama/ollama@sha256:da6e0dc5651df159e45686fd663c4dbe1624a52c44d7280eeac1551d8f865532
# CADDY_IMAGE=caddy@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:b269e8abd07a5bf6f3f4be65d5050b2174eca89c56a0241a8ff32a16aec454e4

PRIME_SPINE_TOKEN=
# Optional read-only Observatory verifier bridge. The reviewed public JWK is
# copied into the candidate image; no signer credential is used by ORQEVIA.
PRIME_AGENT_CERT_AZURE_ES256_ENABLED=0
PRIME_REGISTRY_V1_ENABLED=1
PORTAL_BASE_URL=https://the-portal-ten.vercel.app

# ORQEVIA stays private. This read endpoint remains OFF unless deliberately exposed.
PRIME_PUBLIC_AGENT_TRACE=0

# Outbound public-safe runtime relay. Only sanitized authority metadata is sent.
# The HMAC secret is provisioned separately and must never be committed.
PRIME_PUBLIC_TRACE_RELAY_URL=https://bksyjvppcwfgwoelnyvp.supabase.co/functions/v1/orqevia-trace-relay
PRIME_PUBLIC_TRACE_PUBLISHER_ID=
PRIME_PUBLIC_TRACE_SECRET=
PRIME_PUBLIC_TRACE_INTERVAL_SECONDS=15

# Durable Vercel-to-authoritative-host portfolio event pull path.
PORTFOLIO_RELAY_URL=https://the-portal-ten.vercel.app/api/portfolio-relay
PORTFOLIO_RELAY_TOKEN=
PORTFOLIO_RELAY_INTERVAL_SECONDS=15

# Optional bounded frontier inference; leave blank to remain local-only.
PRIME_FRONTIER_URL=
PRIME_FRONTIER_API_KEY=
PRIME_FRONTIER_MODEL=
PRIME_FRONTIER_MAX_INPUT_CHARS=60000

PRIME_INTEGRATION_TOKEN=
PORTAL_RESULT_URL=https://the-portal-ten.vercel.app/api/experiment-result
PORTAL_RESULT_TOKEN=
PORTAL_PRIME_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
PRIME_PUBLIC_URL=

# Optional Higgsfield media provider. Disabled unless explicitly enabled.
# Do not place API credentials in this file in a committed deployment.
ORQEVIA_HIGGSFIELD_ENABLED=0
ORQEVIA_HIGGSFIELD_API_KEY_REF=env:ORQEVIA_HIGGSFIELD_API_KEY
ORQEVIA_HIGGSFIELD_API_KEY=
ORQEVIA_HIGGSFIELD_API_KEY_ID_REF=
ORQEVIA_HIGGSFIELD_API_KEY_SECRET_REF=
ORQEVIA_HIGGSFIELD_CLI=
ORQEVIA_MEDIA_DB=/data/media-jobs.db
ORQEVIA_MEDIA_MAX_COST_USD=0.25
ORQEVIA_MEDIA_MAX_JOBS_PER_DAY=3
ORQEVIA_MEDIA_MAX_CONCURRENT_JOBS=1
ORQEVIA_MEDIA_HTTP_TIMEOUT_SECONDS=30
ORQEVIA_MEDIA_POLL_TIMEOUT_SECONDS=900
ORQEVIA_MEDIA_POLL_INITIAL_SECONDS=2
ORQEVIA_MEDIA_POLL_MAX_SECONDS=10
ORQEVIA_MEDIA_MAX_UPLOAD_BYTES=104857600

# Optional OpenTelemetry. Disabled by default; collectors must remain loopback.
ORQEVIA_OTEL_ENABLED=0
ORQEVIA_OTEL_ENDPOINT=http://127.0.0.1:4318
ORQEVIA_OTEL_SERVICE_NAME=orqevia
ORQEVIA_OTEL_ENVIRONMENT=abex-local
ORQEVIA_OTEL_SAMPLE_RATIO=0.1
