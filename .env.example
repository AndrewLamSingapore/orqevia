# Local Ollama models
PRIME_FAST_MODEL=gemma3:1b
PRIME_DEEP_MODEL=gemma3:1b
PRIME_EMBED_MODEL=embeddinggemma:300m-qat-q4_0

# Keep PRIME private by default.
PRIME_BIND_ADDRESS=127.0.0.1
PRIME_PORT=8000

# Pin production to the verified commit-addressable image.
# PRIME_IMAGE=ghcr.io/andrewlamsingapore/prime:sha-<verified-40-character-commit>

# Stable Spine + cognitive maintenance/authentication. Use an independent long random value.
PRIME_SPINE_TOKEN=

# The Portal is PRIME's external knowledge grounding source. Read-only from PRIME.
PORTAL_BASE_URL=https://the-portal-ten.vercel.app

# Closed evidence loop. Generate independent long random values locally.
PRIME_INTEGRATION_TOKEN=
PORTAL_RESULT_URL=https://the-portal-ten.vercel.app/api/experiment-result
PORTAL_RESULT_TOKEN=
PORTAL_PRIME_TOKEN=

# Persistent remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
PRIME_PUBLIC_URL=
