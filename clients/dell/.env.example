# The client refuses plain HTTP and refuses to connect until every value is set.
ORQEVIA_ABEX_BASE_URL=https://abex-prime.example.invalid
ORQEVIA_ABEX_EXPECTED_HOST=DESKTOP-BGD97NB
ORQEVIA_ABEX_IDENTITY_SHA256=REPLACE_WITH_64_HEX_CHARACTER_PIN
ORQEVIA_CLIENT_ID=dell:DESKTOP-IPV4PH9
# Set this only in the process environment. Never commit the real value.
ORQEVIA_CLIENT_TOKEN=REPLACE_AT_RUNTIME
# Local Dell UI listener. Non-loopback values are rejected.
ORQEVIA_DELL_LISTEN_HOST=127.0.0.1
ORQEVIA_DELL_LISTEN_PORT=4317
