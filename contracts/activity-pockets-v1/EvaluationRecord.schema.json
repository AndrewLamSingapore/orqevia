{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "enum": [
            "academy",
            "library",
            "tools",
            "factory",
            "orqevia"
          ],
          "title": "Component",
          "type": "string"
        },
        "origin": {
          "default": "runtime",
          "enum": [
            "runtime",
            "controlled-fixture",
            "legacy-adapter"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "component",
        "source_revision",
        "reference"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://orqevia.local/contracts/activity-pockets/v1/EvaluationRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Audit Refs",
      "type": "array"
    },
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "compatibility": {
      "default": [
        "activity-pockets/1"
      ],
      "items": {
        "type": "string"
      },
      "title": "Compatibility",
      "type": "array"
    },
    "correctness_passed": {
      "title": "Correctness Passed",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluator": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evaluator",
      "type": "string"
    },
    "generalization_passed": {
      "title": "Generalization Passed",
      "type": "boolean"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Id",
      "type": "string"
    },
    "owner": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Owner",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "permissions": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "proposal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Proposal Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "regression_results": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Regression Results",
      "type": "array"
    },
    "safety_passed": {
      "title": "Safety Passed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Suite Sha256",
      "type": "string"
    },
    "traceability_passed": {
      "title": "Traceability Passed",
      "type": "boolean"
    }
  },
  "required": [
    "owner",
    "provenance",
    "proposal_id",
    "evaluator",
    "candidate_sha256",
    "suite_sha256",
    "passed",
    "regression_results",
    "safety_passed",
    "correctness_passed",
    "traceability_passed",
    "generalization_passed"
  ],
  "title": "EvaluationRecord",
  "type": "object"
}
