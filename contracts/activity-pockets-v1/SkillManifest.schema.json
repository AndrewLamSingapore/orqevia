{
  "$defs": {
    "ExtractionConfig": {
      "additionalProperties": false,
      "properties": {
        "price_fields": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "type": "string"
          },
          "title": "Price Fields",
          "type": "array"
        },
        "title_fields": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "type": "string"
          },
          "title": "Title Fields",
          "type": "array"
        }
      },
      "required": [
        "title_fields",
        "price_fields"
      ],
      "title": "ExtractionConfig",
      "type": "object"
    },
    "GuidanceConfig": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "advisory_only",
          "default": "advisory_only",
          "title": "Authority",
          "type": "string"
        },
        "instruction": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "instruction"
      ],
      "title": "GuidanceConfig",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "enum": [
            "academy",
            "library",
            "tools",
            "factory",
            "orqevia"
          ],
          "title": "Component",
          "type": "string"
        },
        "origin": {
          "default": "runtime",
          "enum": [
            "runtime",
            "controlled-fixture",
            "legacy-adapter"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "component",
        "source_revision",
        "reference"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://orqevia.local/contracts/activity-pockets/v1/SkillManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Agent Ids",
      "type": "array"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractionConfig"
        },
        {
          "$ref": "#/$defs/GuidanceConfig"
        }
      ],
      "title": "Artifact"
    },
    "audit_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Audit Refs",
      "type": "array"
    },
    "compatibility": {
      "default": [
        "activity-pockets/1"
      ],
      "items": {
        "type": "string"
      },
      "title": "Compatibility",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Id",
      "type": "string"
    },
    "owner": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Owner",
      "type": "string"
    },
    "permissions": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_id": {
      "default": "web.structured-extraction",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Skill Id",
      "type": "string"
    },
    "tool_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Tool Ids",
      "type": "array"
    },
    "version": {
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "owner",
    "provenance",
    "version",
    "agent_ids",
    "tool_ids",
    "artifact"
  ],
  "title": "SkillManifest",
  "type": "object"
}
