{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/reasoning-output-v1.schema.json",
  "title": "ReasoningOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["confidence","decision_summary"],
  "properties": {
    "recommendation": {"type": ["string","null"]},
    "proposed_action": {"$ref": "action-envelope-v1.schema.json"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_summary": {"type": "object"},
    "reasoner_version": {"type": ["string","null"]}
  },
  "anyOf": [
    {"required": ["recommendation"]},
    {"required": ["proposed_action"]}
  ]
}
