{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AndrewLamSingapore/AndrewLamSingapore/main/portfolio-contracts/schemas/action-envelope-v1.schema.json",
  "title": "JARVIS Shared Action Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "actor_id", "actor_type", "action", "parameters", "context", "correlation_id", "idempotency_key", "schema_version", "timestamp"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "actor_type": { "type": "string", "enum": ["user", "reasoner", "system", "device", "service"] },
    "action": { "type": "string", "minLength": 1 },
    "parameters": { "type": "object" },
    "context": { "type": "object" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
