{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/action-envelope-v1.schema.json",
  "title": "ActionEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id","actor_id","actor_type","action","parameters","context","correlation_id","idempotency_key","schema_version","timestamp"],
  "properties": {
    "tenant_id": {"const": "personal"},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_type": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "context": {"type": "object"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
