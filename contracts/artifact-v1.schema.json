{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRIME artifact v1",
  "type": "object",
  "required": [
    "artifact_id",
    "task_id",
    "sha256"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}