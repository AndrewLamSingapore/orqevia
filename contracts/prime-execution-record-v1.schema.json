{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-prime.local/contracts/prime-execution-record-v1.schema.json",
  "title": "JARVIS PRIME Consequential Execution Record v1",
  "type": "object",
  "required": ["task_id", "objective", "timestamp_started", "executor_device", "repository_id", "branch", "base_commit_sha", "final_execution_result", "verification_state"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "timestamp_started": {"type": "string", "format": "date-time"},
    "timestamp_completed": {"type": ["string", "null"], "format": "date-time"},
    "executor_device": {"type": "string", "minLength": 1},
    "agent": {"type": ["string", "null"]},
    "repository_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "base_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "github_remote_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "artifact_ids": {"type": "array", "items": {"type": "string"}},
    "artifact_locations": {"type": "array", "items": {"type": "string"}},
    "evidence_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
    "tests_executed": {"type": "array", "items": {"type": "string"}},
    "test_results": {"type": "array", "items": {"type": "object"}},
    "retries": {"type": "integer", "minimum": 0},
    "repairs": {"type": "array", "items": {"type": "string"}},
    "model_tier": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "final_execution_result": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "UNKNOWN"]},
    "verification_state": {"enum": ["VERIFIED", "UNVERIFIED", "DISPUTED", "STALE", "DIVERGED", "FAILED", "UNKNOWN"]},
    "verifier": {"type": ["string", "null"]},
    "reconciliation_timestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
